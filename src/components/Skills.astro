---
import { services, technologyGroups } from "../data/profile";
---

<section id="que-hago" class="scroll-mt-24 border-b border-line">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent-text">02 / Qué hago</p>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Sistemas y aplicaciones a la medida.</h2>
      <p class="mt-4 text-base leading-7 text-fg-soft">De la API a la persistencia, con seguridad y decisiones que hacen más sencillo mantener cada sistema.</p>
    </div>

    <div class="mt-10 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <ul class="divide-y divide-line border-y border-line">
        {services.map((service, index) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-3 py-4 text-sm leading-6">
            <span class="font-mono text-xs text-accent-text">0{index + 1}</span>
            <span>{service}</span>
          </li>
        ))}
      </ul>

      <div class="grid gap-7 sm:grid-cols-2">
        {technologyGroups.map((group) => (
          <div>
            <h3 class="border-b border-line pb-3 text-sm font-semibold">{group.title}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-9 items-center gap-2 rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs text-fg-soft transition-colors hover:border-accent-text hover:text-accent-text" aria-label={`${item.name}, sitio oficial (abre en una pestaña nueva)`}>
                  {typeof item.icon !== "string" ? (
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-accent-text" fill="currentColor">
                      <path d={item.icon.path} />
                    </svg>
                  ) : item.icon === "database" ? (
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-accent-text" fill="none" stroke="currentColor" stroke-width="1.7">
                      <ellipse cx="12" cy="5" rx="8" ry="3" />
                      <path stroke-linecap="round" d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3" />
                    </svg>
                  ) : (
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-accent-text" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                      <path d="m8 6-6 6 6 6m8-12 6 6-6 6M14 4l-4 16" />
                    </svg>
                  )}
                  {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>