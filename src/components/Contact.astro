---
import { profile } from "../data/profile";
import { siGithub, siGmail, siWhatsapp } from "simple-icons";

const gmailComposeUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(profile.email)}`;
---

<section id="contacto" class="scroll-mt-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent-text">04 / Contacto</p>
      <h2 class="mt-4 max-w-xl text-3xl font-semibold sm:text-4xl">¿Tienes una idea, un proceso que automatizar o un sistema que hacer crecer?</h2>
      <p class="mt-4 max-w-lg text-base leading-7 text-fg-soft">Ayudo a negocios de cualquier tamaño —desde proyectos locales hasta empresas en expansión— a resolver sus necesidades tecnológicas. Diseño backend a la medida, APIs eficientes y aplicaciones orientadas a optimizar tu operación. Hablemos de cómo darle solución a tu proyecto.</p>
    </div>
    <div class="flex flex-col items-start gap-4 lg:items-end">
      <a href={gmailComposeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Redactar en Gmail para ${profile.email}`} class="inline-flex min-h-14 items-center gap-3 rounded-md border border-line px-4 py-2 text-fg transition-colors hover:border-accent-text hover:text-accent-text">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 shrink-0" fill="currentColor">
          <path d={siGmail.path} />
        </svg>
        <span class="flex flex-col items-start">
          <span class="text-sm font-semibold">Gmail</span>
          <span class="text-xs text-fg-soft">{profile.email}</span>
        </span>
      </a>
      <div class="flex flex-wrap gap-3">
        <a href={`https://wa.me/${profile.whatsappNumber}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp al +52 352 129 7591, abre en una pestaña nueva" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-line px-4 text-sm font-semibold text-fg transition-colors hover:border-accent-text hover:text-accent-text">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
            <path d={siWhatsapp.path} />
          </svg>
          WhatsApp
        </a>
        <a href={profile.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn, abre en una pestaña nueva" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-line px-4 text-sm font-semibold text-fg transition-colors hover:border-accent-text hover:text-accent-text">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V8.99H7.1v11.46ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.44c.98 0 1.79-.77 1.79-1.72V1.72C24 .77 23.19 0 22.22 0Z" />
          </svg>
          LinkedIn
        </a>
        {profile.githubUrl.startsWith("https://") && !profile.githubUrl.includes("TODO") ? (
          <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub, abre en una pestaña nueva" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-line px-4 text-sm font-semibold text-fg transition-colors hover:border-accent-text hover:text-accent-text">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <path d={siGithub.path} />
            </svg>
            GitHub
          </a>
        ) : (
          <span aria-label="GitHub: falta agregar el enlace" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-line px-4 text-sm font-semibold text-fg-soft">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <path d={siGithub.path} />
            </svg>
            GitHub · TODO
          </span>
        )}
      </div>
    </div>
  </div>
</section>